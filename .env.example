# Server-side only — never exposed to the client. The proxy routes and the
# capture script read it. Any Solana JSON-RPC provider works (Alchemy,
# Helius, QuickNode, ...); the URL must include your key.
# e.g. https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
SOLANA_RPC_URL=https://your-rpc-provider.example/YOUR_KEY

# Optional: the site's public base URL, used for absolute URLs in the og
# cards and the Farcaster manifest. On Vercel it is auto-detected, but set
# it explicitly when serving a custom domain (the Farcaster manifest
# signature must match this domain exactly).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
